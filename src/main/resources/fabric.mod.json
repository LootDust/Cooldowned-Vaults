	"authors": [
		"Lootdust"
	],
	"license": "CC0-1.0",
	"icon": "assets/cooldownedvaults/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.lootdust.cooldownedvaults.CooldownedVaults"
		]
	},
